# ============================================================
# IG Harness セットアップ用 環境変数
#   cp .env.example .env  →  値を埋める  →  ./deploy.sh
#   .env は .gitignore 済み。絶対にコミットしないこと。
# ============================================================

# ---------- Cloudflare（deploy.sh を非対話で動かすために必要） ----------
# API トークン: https://dash.cloudflare.com/profile/api-tokens → 「トークンを作成」→「カスタムトークン」
#   必要な権限（すべて「編集」）:
#     アカウント: Workers スクリプト / Workers R2 ストレージ / D1 / Cloudflare Pages
#     アカウント: アカウント設定「読み取り」
#     ユーザー:   ユーザー詳細「読み取り」/ メンバーシップ「読み取り」
CLOUDFLARE_API_TOKEN=
# アカウント ID: https://dash.cloudflare.com → 右サイドバー「アカウント ID」（32桁の16進数）
CLOUDFLARE_ACCOUNT_ID=

# ---------- Meta / Instagram（Meta for Developers から取得） ----------
# アプリの設定 → ベーシック → 「Instagram アプリシークレット」（Webhook 署名検証に使う）
IG_APP_SECRET=
# Instagram API ダッシュボード → ステップ2 → 「トークンを生成」（EAA… / IGQ… で始まる長い文字列。60日有効、Worker が自動更新）
IG_ACCESS_TOKEN=
# Instagram API ダッシュボード → ステップ2 → テスターとして追加した自分のアカウント横の数字（Instagram プロアカウント ID）
IG_USER_ID=

# ---------- 任意（空なら deploy.sh が自動生成し .deployed.env に保存） ----------
# Webhook 検証トークン。Meta コンソールの「トークンを認証」に同じ値を入れる
IG_VERIFY_TOKEN=
# 管理画面 / API / MCP で使う Bearer キー
API_KEY=
# Worker・D1・R2 の名前に付く衝突回避サフィックス（8桁16進）
RESOURCE_SUFFIX=
# LINE Harness と UUID クロスリンクする時の共有シークレット（LINE 側に IG_HARNESS_LINK_SECRET として同じ値を設定）
LINE_HARNESS_LINK_SECRET=

# ---------- 任意（Worker の表示に使う） ----------
# 自分の Instagram ユーザー名（@なし）。/connect ページの「DMを開く」リンクに使う
IG_USERNAME=
# プライバシーポリシーページに載せる連絡先メール
CONTACT_EMAIL=
