{
  "mcpServers": {
    "line-harness": {
      "command": "npx",
      "args": ["-y", "@line-harness/mcp-server@latest"],
      "env": {
        "LINE_HARNESS_API_URL": "https://roots-line.<subdomain>.workers.dev",
        "LINE_HARNESS_API_KEY": "sk-xxxxxxxxxxxxxxxx",
        "LINE_HARNESS_ACCOUNT_ID": ""
      }
    }
  }
}
