# LINE2（講義 → 個別相談会）用の接続情報。.env.lecture にコピーして使う（git には入らない）
# Worker と API Key は LINE1 と共通。アカウントID・予約ページ・講義ページだけ LINE2 のもの
LINE_HARNESS_API_URL=https://roots-line.re-tro.workers.dev
LINE_HARNESS_API_KEY=sk-xxxxxxxxxxxxxxxx
# 管理画面「LINEアカウント」で LINE2 を追加したあと、/api/line-accounts で取れる id
LINE_HARNESS_ACCOUNT_ID=e2282bd6-1c22-481a-b07b-14231154a425
# LINE2 の LIFF ID で組み立てる予約ページ
BOOKING_URL=https://liff.line.me/2011653383-oiECpx5P?page=book
# 講義動画ページの LIFF URL（lecture-page を LIFF アプリとして登録した ID）
LECTURE_PAGE_URL=https://liff.line.me/2011653383-ta1zojXE
# 特典エクササイズ動画の URL。現在の文面（config/messages/lecture/bonus-01.txt）には URL がそのまま書いてあるので未設定でよい
# （文面に __BONUS1_URL__ / __BONUS2_URL__ を書いた場合だけ必要）
#BONUS1_URL=https://youtu.be/XXXXXXXXXXX
#BONUS2_URL=https://youtu.be/YYYYYYYYYYY
