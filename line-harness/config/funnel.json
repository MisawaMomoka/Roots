{
  "$comment": "診断会ファネルの定義。apply.mjs がこのファイルを L Harness に反映し、sync-bookings.mjs が予約に応じてシナリオ登録する。",

  "autoApprove": true,
  "thanksMaxAgeMinutes": 180,
  "prevDay": { "time": "19:00", "cutoffTime": "22:00" },
