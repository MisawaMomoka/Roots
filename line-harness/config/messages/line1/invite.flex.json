{
  "type": "bubble",
  "size": "mega",
  "header": {
    "type": "box",
    "layout": "vertical",
    "paddingAll": "lg",
    "contents": [
      { "type": "text", "text": "__GREETING__", "size": "sm", "wrap": true }
    ]
  },
  "hero": {
    "type": "image",
    "url": "__THUMB_URL__",
    "size": "full",
    "aspectRatio": "__THUMB_ASPECT__",
    "aspectMode": "cover",
    "action": { "type": "uri", "label": "講義を受け取る", "uri": "{{auth_url:__LINE2_CHANNEL_ID__}}" }
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      { "type": "text", "text": "やせ習慣1Day講義", "weight": "bold", "size": "xl", "wrap": true }
    ]
  },
  "footer": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "button",
        "style": "primary",
        "color": "#06C755",
        "height": "md",
        "action": { "type": "uri", "label": "講義を受け取る（無料）", "uri": "{{auth_url:__LINE2_CHANNEL_ID__}}" }
      }
    ]
  }
