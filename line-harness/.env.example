# L Harness 接続情報（.env にコピー。.env は git に入らない）
LINE_HARNESS_API_URL=https://roots-line.<subdomain>.workers.dev
LINE_HARNESS_API_KEY=sk-xxxxxxxxxxxxxxxx
# GET /api/line-accounts の id（01-setup.md §2-3）
LINE_HARNESS_ACCOUNT_ID=
# 予約ページURL（welcome-01.txt の __BOOKING_URL__ に入る）。LIFF ID は /api/line-accounts の liffId
BOOKING_URL=https://liff.line.me/0000000000-xxxxxxxx?page=book

# 任意：標準リマインド（24時間前・2時間前）を止めたいときだけ。wrangler ログイン済みのマシンで動かすこと
# LINE_HARNESS_D1_NAME=line-harness
# LINE_HARNESS_WORKER_DIR=~/.line-harness/apps/worker
