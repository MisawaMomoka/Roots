# LINE1（理駆・既存の公式LINE）用。.env.line1 にコピーして使う（git には入らない）
LINE_HARNESS_API_URL=https://roots-line.re-tro.workers.dev
LINE_HARNESS_API_KEY=sk-xxxxxxxxxxxxxxxx
# /api/line-accounts で LINE1（liffId が LINE2 のものでない方）の id。必ず入れる（空だと全アカウント共通のシナリオになってしまう）
LINE_HARNESS_ACCOUNT_ID=d8da221a-0d22-4fbb-b747-3818ca7d80ab
# 誘導先 LINE2 の Messaging API チャネルID
LINE2_CHANNEL_ID=2011652832
# サムネイル画像の URL（lecture-page に thumb.jpg を置いて配備すれば https://roots-lecture.pages.dev/thumb.jpg）
THUMB_URL=https://roots-lecture.pages.dev/thumb.jpg
# 画像の縦横比（横長 16:9 ／ 正方形 1:1 ／ 縦長 3:4 など）
THUMB_ASPECT=16:9
